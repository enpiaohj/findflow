{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FindFlow",
  "version": "0.9.0",
  "identifier": "com.findflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FindFlow",
        "url": "index.html",
        "width": 1000,
        "height": 620,
        "minWidth": 760,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "skipTaskbar": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "windows/installer-hooks.nsh"
      },
      "wix": {
        "language": {
          "zh-CN": {
            "localePath": "windows/wix-zh-CN.wxl"
          }
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1MTQ0MkU4Mjk3MDc3NgpSV1IyQjVlQ0xrUlJDdndMWjArdXdwRUk3NzQycEVWdzVRdCt3RTZ2ekJKd1J6UTFYRnMwVnkxcAo=",
      "endpoints": [
        "https://github.com/enpiaohj/findflow/releases/latest/download/latest.json"
      ]
    }
  }
}
